---
import {
  ALL_LOCALE_CODES,
  LOCALE_REGISTRY,
  localizePath,
  switchLocaleInPath,
  useTranslations,
  type LocaleCode,
} from '../i18n';
import { getMegaMenu } from '../config/navigation';

interface Props {
  locale: LocaleCode;
  currentSlug: string;
  activeSectionTitle?: string;
  isLanding?: boolean;
}

const {
  locale,
  currentSlug,
  activeSectionTitle = 'Overview',
  isLanding = false,
} = Astro.props;

const t = useTranslations(locale);
const topTabs = getMegaMenu(locale);
const currentPath = localizePath(currentSlug, locale);
---

<header class="nlx-header">
  <div class="nlx-header__toolbar">
    <div class="nlx-header__left">
      {!isLanding && (
        <button
          type="button"
          class="nlx-icon-btn nlx-mobile-menu-btn"
          id="nlx-mobile-menu-toggle"
          aria-label="Toggle side navigation"
        >
          <svg width="20" height="20" viewBox="0 0 256 256" fill="currentColor">
            <path d="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z"/>
          </svg>
        </button>
      )}

      <a href={localizePath('', locale)} class="nlx-brand" data-link-location="HeaderLogo" data-astro-prefetch>
        <img src="/assets/nalix.png" alt="Nalix" class="nlx-brand__logo" width="22" height="22" decoding="async" />
        <span>{t('site.headerBrand')}</span>
      </a>

      <div class="nlx-header__vdivider" role="separator" aria-orientation="vertical"></div>

      <nav class="nlx-topnav" aria-label={t('nav.primarySections')}>
        {topTabs.map((tab, index) => {
          const isActive = !isLanding && tab.sectionTitles.includes(activeSectionTitle);
          const panelId = `nlx-mega-${index}`;
          return (
            <div class="nlx-topnav__item" data-mega>
              <a
                href={tab.href}
                class:list={['nlx-topnav__link', { 'is-active': isActive }]}
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls={panelId}
                data-mega-trigger
                data-astro-prefetch
              >
                {tab.title}
                <svg class="nlx-topnav__chevron" data-mega-toggle width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </a>
              <div class="nlx-mega" id={panelId} role="region" aria-label={tab.title} style={`--mega-cols:${Math.min(Math.max(tab.columns.length, 1), 5)}`}>
                <div class="nlx-mega__inner">
                  {tab.columns.map((column) => (
                    <div class="nlx-mega__col">
                      <div class="nlx-mega__heading">
                        {column.title ? (column.href ? <a href={column.href} data-astro-prefetch>{column.title}</a> : column.title) : '\u00a0'}
                      </div>
                      <ul class="nlx-mega__list">
                        {column.links.map((link) => (
                          <li>
                            <a
                              href={link.href}
                              class="nlx-mega__link"
                              target={link.external ? '_blank' : undefined}
                              rel={link.external ? 'noopener noreferrer' : undefined}
                              data-astro-prefetch={link.external ? undefined : ''}
                            >
                              <span>{link.title}</span>
                              {link.external && (
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                  <path d="M15 3h6v6M10 14 21 3M18 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5" />
                                </svg>
                              )}
                            </a>
                          </li>
                        ))}
                      </ul>
                      {column.more && (
                        <a href={column.more.href} class="nlx-mega__more" data-astro-prefetch>{column.more.title} →</a>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          );
        })}
      </nav>
    </div>

    <div class="nlx-header__right">
      <button
        type="button"
        class="nlx-search-trigger"
        id="nlx-search-open"
        aria-label={t('nav.searchPlaceholder')}
      >
        <span class="nlx-search-trigger__left">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <circle cx="11" cy="11" r="7"/>
            <path d="m20 20-3.5-3.5" stroke-linecap="round"/>
          </svg>
          <span>{t('nav.searchPlaceholder')}</span>
        </span>
        <kbd>{t('nav.searchShortcut')}</kbd>
      </button>

      <!-- Theme Switcher -->
      <button
        type="button"
        class="nlx-icon-btn"
        id="nlx-theme-toggle"
        aria-label={t('nav.themeToggle')}
        title={t('nav.themeToggle')}
      >
        <svg class="nlx-theme-icon nlx-theme-icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" stroke-linecap="round"/>
        </svg>
        <svg class="nlx-theme-icon nlx-theme-icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>
        </svg>
      </button>

      <!-- Text density -->
      <div class="nlx-lang-switcher" id="nlx-density-switcher">
        <button
          type="button"
          class="nlx-icon-btn nlx-density-btn"
          id="nlx-density-btn"
          aria-label={t('nav.density')}
          title={t('nav.density')}
          aria-haspopup="true"
          aria-expanded="false"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <g transform="translate(1.1 0)">
              <path d="m1.5 19 5.5-13 5.5 13M3.6 15h6.8" />
              <circle cx="17.5" cy="15.5" r="2.8" />
              <path d="M20.3 12.7V19" />
            </g>
          </svg>
        </button>

        <div class="nlx-lang-menu" role="menu">
          {(['dense', 'normal', 'comfortable'] as const).map((value) => (
            <button type="button" class="nlx-lang-option nlx-density-option" role="menuitemradio" aria-checked="false" data-density={value}>
              <span>{t(`density.${value}`)}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Locale Switcher -->
      <div class="nlx-lang-switcher" id="nlx-lang-switcher">
        <button
          type="button"
          class="nlx-icon-btn"
          id="nlx-lang-btn"
          aria-label={t('nav.language')}
          title={t('nav.language')}
          aria-haspopup="true"
          aria-expanded="false"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" />
            <path d="M3.5 12h17" />
            <path d="M12 3.5c2.2 2.3 3.3 5.1 3.3 8.5s-1.1 6.2-3.3 8.5c-2.2-2.3-3.3-5.1-3.3-8.5S9.8 5.8 12 3.5Z" />
          </svg>
        </button>

        <div class="nlx-lang-menu" role="menu">
          {ALL_LOCALE_CODES.map((code) => {
            const def = LOCALE_REGISTRY[code];
            const targetHref = switchLocaleInPath(currentPath, code);
            const isCurrent = code === locale;
            return def.enabled ? (
              <a
                href={targetHref}
                class:list={['nlx-lang-option', { 'is-active': isCurrent }]}
                role="menuitem"
                aria-current={isCurrent ? 'true' : undefined}
              >
                <span>{def.nativeLabel}</span>
              </a>
            ) : (
              <span class="nlx-lang-option is-disabled" role="menuitem" title={t('nav.langSoonHint')}>
                <span>{def.nativeLabel}</span>
                <span class="nlx-lang-badge">{t('nav.comingSoon')}</span>
              </span>
            );
          })}
        </div>
      </div>

      <!-- GitHub Repository -->
      <a
        href="https://github.com/ppn-systems/nalix"
        target="_blank"
        rel="noopener noreferrer"
        class="nlx-icon-btn"
        aria-label={t('nav.githubLabel')}
        title={t('nav.githubLabel')}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.92.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11.05 11.05 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  // Hover-intent, keyboard and touch handling for the navigation panels.
  const OPEN_DELAY_MS = 70;
  const CLOSE_DELAY_MS = 160;
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-mega]'));
  let openTimer: number | undefined;
  let closeTimer: number | undefined;

  const triggerOf = (item: HTMLElement) => item.querySelector<HTMLElement>('[data-mega-trigger]')!;
  const panelOf = (item: HTMLElement) => item.querySelector<HTMLElement>('.nlx-mega')!;

  function place(item: HTMLElement) {
    const panel = panelOf(item);
    panel.style.setProperty('--mega-shift', '0px');
    const rect = panel.getBoundingClientRect();
    const overflow = rect.right - (window.innerWidth - 16);
    if (overflow > 0) panel.style.setProperty('--mega-shift', `${-overflow}px`);
  }

  function close(item: HTMLElement) {
    item.classList.remove('is-open');
    triggerOf(item).setAttribute('aria-expanded', 'false');
  }

  function open(item: HTMLElement) {
    items.forEach((other) => other !== item && close(other));
    item.classList.add('is-open');
    triggerOf(item).setAttribute('aria-expanded', 'true');
    place(item);
  }

  items.forEach((item) => {
    const trigger = triggerOf(item);

    item.addEventListener('pointerenter', (event) => {
      if ((event as PointerEvent).pointerType === 'touch') return;
      window.clearTimeout(closeTimer);
      openTimer = window.setTimeout(() => open(item), OPEN_DELAY_MS);
    });
    item.addEventListener('pointerleave', (event) => {
      if ((event as PointerEvent).pointerType === 'touch') return;
      window.clearTimeout(openTimer);
      closeTimer = window.setTimeout(() => close(item), CLOSE_DELAY_MS);
    });
    item.addEventListener('focusin', () => open(item));
    item.addEventListener('focusout', (event) => {
      if (!item.contains((event as FocusEvent).relatedTarget as Node | null)) close(item);
    });
    item.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && item.classList.contains('is-open')) {
        close(item);
        trigger.focus();
      } else if (event.key === 'ArrowDown' && event.target === trigger) {
        event.preventDefault();
        open(item);
        panelOf(item).querySelector<HTMLElement>('a')?.focus();
      }
    });
    // The label always follows the link; the chevron opens or closes the panel (touch, or a mouse click).
    const toggle = trigger.querySelector('[data-mega-toggle]');
    let wasOpen = false; // focusing the link opens the panel before the click arrives
    toggle?.addEventListener('pointerdown', () => {
      wasOpen = item.classList.contains('is-open');
    });
    toggle?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      if (wasOpen) close(item);
      else open(item);
    });
  });

  document.addEventListener('pointerdown', (event) => {
    items.forEach((item) => {
      if (!item.contains(event.target as Node)) close(item);
    });
  });
  window.addEventListener('resize', () => items.forEach(close));
</script>
