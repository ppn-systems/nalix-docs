---
import { localizePath, useTranslations, type LocaleCode, type TranslationKey } from '../i18n';
import HeroBackdrop from './HeroBackdrop.astro';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

interface ProductCardItem {
  id: 'start' | 'guides' | 'concepts' | 'packages' | 'api' | 'benchmarks';
  href: string;
  icon: 'rocket' | 'compass' | 'layers' | 'box' | 'code' | 'gauge';
  /** `key` is a dictionary entry (`home.topic.<key>`); `label` is used as written (package names). */
  topics: Array<{ key?: string; label?: string; slug: string }>;
}

const productCards: ProductCardItem[] = [
  {
    id: 'start',
    href: localizePath('quickstart', locale),
    icon: 'rocket',
    topics: [
      { key: 'quickStart', slug: 'quickstart' },
      { key: 'installation', slug: 'installation' },
      { key: 'firstServer', slug: 'guides/getting-started/your-first-server' },
      { key: 'serverBlueprint', slug: 'guides/getting-started/server-blueprint' },
    ],
  },
  {
    id: 'guides',
    href: localizePath('guides', locale),
    icon: 'compass',
    topics: [
      { key: 'chatRoom', slug: 'guides/build-a-chat-room' },
      { key: 'packetHandlers', slug: 'guides/application/packet-handlers' },
      { key: 'tcpPatterns', slug: 'guides/networking/tcp-patterns' },
      { key: 'productionChecklist', slug: 'guides/deployment/production-checklist' },
    ],
  },
  {
    id: 'concepts',
    href: localizePath('concepts', locale),
    icon: 'layers',
    topics: [
      { key: 'howPacketsWork', slug: 'concepts/how-packets-work' },
      { key: 'architecture', slug: 'concepts/internals/architecture' },
      { key: 'binarySpec', slug: 'concepts/internals/binary-spec' },
      { key: 'zeroAllocation', slug: 'concepts/internals/zero-allocation' },
    ],
  },
  {
    id: 'packages',
    href: localizePath('packages', locale),
    icon: 'box',
    topics: [
      { label: 'Nalix.Hosting', slug: 'packages/nalix-hosting' },
      { label: 'Nalix.Network', slug: 'packages/nalix-network' },
      { label: 'Nalix.Runtime', slug: 'packages/nalix-runtime' },
      { label: 'Nalix.SDK', slug: 'packages/nalix-sdk' },
    ],
  },
  {
    id: 'api',
    href: localizePath('api', locale),
    icon: 'code',
    topics: [
      { key: 'networkApi', slug: 'api/network' },
      { key: 'runtimeApi', slug: 'api/runtime' },
      { key: 'sdkApi', slug: 'api/sdk' },
      { key: 'diagnosticCodes', slug: 'api/analyzers/diagnostic-codes' },
    ],
  },
  {
    id: 'benchmarks',
    href: localizePath('benchmarks', locale),
    icon: 'gauge',
    topics: [
      { key: 'networkComparison', slug: 'benchmarks/network-comparison' },
      { key: 'infrastructure', slug: 'benchmarks/infrastructure' },
      { key: 'memory', slug: 'benchmarks/memory' },
      { key: 'serialization', slug: 'benchmarks/serialization' },
    ],
  },
];
---

<div class="nlx-home-wrapper">
  <div class="nlx-home-container">
    <!-- Top Hero Card -->
    <div class="nlx-home-hero-card">
      <HeroBackdrop />

      <div class="nlx-home-hero__content">
        <h1 class="nlx-home-hero__title">{t('hero.title')}</h1>
        <p class="nlx-home-hero__subtitle">{t('hero.subtitle')}</p>

        <div class="nlx-home-search-bar" data-locale={locale} data-empty-text={t('search.noResults')}>
          <div class="nlx-home-search-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--text-secondary); flex-shrink: 0;">
              <circle cx="11" cy="11" r="7"/>
              <path d="m20 20-3.5-3.5" stroke-linecap="round"/>
            </svg>
            <input
              type="text"
              id="nlx-hero-search-input"
              class="nlx-home-search-input"
              placeholder={t('nav.searchPlaceholder')}
              autocomplete="off"
              role="combobox"
              aria-expanded="false"
              aria-controls="nlx-hero-results"
              aria-autocomplete="list"
            />
          </div>
          <button type="button" id="nlx-hero-search-btn" class="nlx-btn-primary nlx-home-search-btn">
            {t('nav.searchButton')}
          </button>
          <div class="nlx-search-pop" id="nlx-hero-results" role="listbox" hidden></div>
        </div>
      </div>
    </div>

    <!-- 2-Column Product Cards Grid -->
    <div class="nlx-product-grid">
      {productCards.map((card) => (
        <div class="nlx-product-card">
          <div>
            <div class="nlx-product-card__header">
              <a href={card.href} class="nlx-product-card__title-link" data-astro-prefetch>
                <span class="nlx-product-card__icon" aria-hidden="true">
                  {card.icon === 'rocket' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
                      <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
                      <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
                    </svg>
                  )}
                  {card.icon === 'compass' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/>
                      <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
                    </svg>
                  )}
                  {card.icon === 'layers' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                      <polyline points="2 17 12 22 22 17"/>
                      <polyline points="2 12 12 17 22 12"/>
                    </svg>
                  )}
                  {card.icon === 'box' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
                      <path d="m3.3 7 8.7 5 8.7-5M12 22V12"/>
                    </svg>
                  )}
                  {card.icon === 'code' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="16 18 22 12 16 6"/>
                      <polyline points="8 6 2 12 8 18"/>
                    </svg>
                  )}
                  {card.icon === 'gauge' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m12 14 4-4"/>
                      <path d="M3.34 19a10 10 0 1 1 17.32 0"/>
                    </svg>
                  )}
                </span>
                <h2 class="nlx-product-card__title">{t(`home.card.${card.id}.title` as TranslationKey)}</h2>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
            <p class="nlx-product-card__desc">{t(`home.card.${card.id}.desc` as TranslationKey)}</p>
          </div>

          <div class="nlx-product-card__topics">
            <div class="nlx-product-card__topics-label">{t('home.exploreTopics')}</div>
            <div class="nlx-product-card__links">
              {card.topics.map((topic) => (
                <a href={localizePath(topic.slug, locale)} class="nlx-topic-link" data-astro-prefetch>
                  {topic.key ? t(`home.topic.${topic.key}` as TranslationKey) : topic.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Home Portal Footer -->
    <footer class="nlx-home-footer">
      <div>
        <span>{t('footer.copyright')}</span>
      </div>
      <div class="nlx-home-footer__links">
        <a href="https://github.com/ppn-systems/nalix" target="_blank" rel="noopener noreferrer">{t('nav.github')}</a>
        <a href="https://www.nuget.org/packages?q=Nalix" target="_blank" rel="noopener noreferrer">{t('nav.nuget')}</a>
        <a href={localizePath('quickstart', locale)} data-astro-prefetch>{t('nav.startHere')}</a>
        <a href={localizePath('api', locale)} data-astro-prefetch>{t('nav.api')}</a>
      </div>
    </footer>
  </div>
</div>

<script>
  import { attachInlineSearch } from '../scripts/inline-search';

  const bar = document.querySelector<HTMLElement>('.nlx-home-search-bar');
  const input = document.getElementById('nlx-hero-search-input') as HTMLInputElement | null;
  const list = document.getElementById('nlx-hero-results');
  if (bar && input && list) {
    const { run } = attachInlineSearch({
      input,
      list,
      locale: bar.dataset.locale || 'en-us',
      emptyText: bar.dataset.emptyText || '',
    });
    document.getElementById('nlx-hero-search-btn')?.addEventListener('click', () => (input.value.trim() ? run() : input.focus()));
  }
</script>
