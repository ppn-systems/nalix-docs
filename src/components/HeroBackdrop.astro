---
// Decorative animated backdrop for the home hero. Pure SVG + CSS, no scripts.
---
<svg class="nlx-hero-bg" viewBox="0 0 1200 320" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <radialGradient id="nlxHeroSpotCenter" cx="50%" cy="0%" r="70%">
      <stop offset="0%" stop-color="#2584f4" stop-opacity="0.22" />
      <stop offset="55%" stop-color="#0a6ec8" stop-opacity="0.06" />
      <stop offset="100%" stop-color="#0a6ec8" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="nlxHeroSpotLeft" cx="12%" cy="80%" r="45%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.16" />
      <stop offset="100%" stop-color="#38bdf8" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="nlxHeroSpotRight" cx="88%" cy="20%" r="45%">
      <stop offset="0%" stop-color="#6366f1" stop-opacity="0.18" />
      <stop offset="100%" stop-color="#6366f1" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="nlxHeroBeam" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="currentColor" stop-opacity="0" />
      <stop offset="50%" stop-color="#68b0ff" stop-opacity="0.7" />
      <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
    </linearGradient>
    <linearGradient id="nlxHeroSweep" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#68b0ff" stop-opacity="0" />
      <stop offset="50%" stop-color="#68b0ff" stop-opacity="0.12" />
      <stop offset="100%" stop-color="#68b0ff" stop-opacity="0" />
    </linearGradient>
    <pattern id="nlxHeroGrid" width="48" height="48" patternUnits="userSpaceOnUse">
      <path d="M 48 0 L 0 0 0 48" fill="none" stroke="currentColor" stroke-opacity="0.06" stroke-width="1" />
    </pattern>
    <radialGradient id="nlxGridMaskGrad" cx="50%" cy="45%" r="58%">
      <stop offset="0%" stop-color="white" stop-opacity="1" />
      <stop offset="75%" stop-color="white" stop-opacity="0.45" />
      <stop offset="100%" stop-color="white" stop-opacity="0" />
    </radialGradient>
    <mask id="nlxGridMask"><rect width="1200" height="320" fill="url(#nlxGridMaskGrad)" /></mask>
  </defs>

  <g class="nlx-hero-bg__glows">
    <rect width="1200" height="320" fill="url(#nlxHeroSpotCenter)" class="nlx-hero-bg__breathe" />
    <rect width="1200" height="320" fill="url(#nlxHeroSpotLeft)" class="nlx-hero-bg__drift" />
    <rect width="1200" height="320" fill="url(#nlxHeroSpotRight)" class="nlx-hero-bg__drift nlx-hero-bg__drift--b" />
  </g>

  <g mask="url(#nlxGridMask)">
    <rect x="-48" y="-48" width="1296" height="416" fill="url(#nlxHeroGrid)" class="nlx-hero-bg__grid" />
  </g>

  <rect x="-300" y="0" width="300" height="320" fill="url(#nlxHeroSweep)" class="nlx-hero-bg__sweep" />

  <g class="nlx-hero-bg__wing nlx-hero-bg__wing--left" stroke="#68b0ff" stroke-width="1.5" stroke-linecap="round">
    <g stroke-opacity="0.25">
          <path d="M-20 72 H110 L152 114 H250" pathLength="100" class="nlx-hero-bg__trace" style="--i:0" />
          <path d="M-20 168 H84 L120 204 H210" pathLength="100" class="nlx-hero-bg__trace" style="--i:1" />
          <path d="M40 280 H144 L184 240 H280" pathLength="100" class="nlx-hero-bg__trace" style="--i:2" />
    </g>
    <g stroke-opacity="0.95" stroke-width="2">
          <path d="M-20 72 H110 L152 114 H250" pathLength="100" class="nlx-hero-bg__packet" style="--i:0" />
          <path d="M-20 168 H84 L120 204 H210" pathLength="100" class="nlx-hero-bg__packet" style="--i:1" />
          <path d="M40 280 H144 L184 240 H280" pathLength="100" class="nlx-hero-bg__packet" style="--i:2" />
    </g>
  </g>
  <g fill="#68b0ff">
    <circle cx="110" cy="72" r="3" class="nlx-hero-bg__node" style="--i:0" />
    <circle cx="250" cy="114" r="3.5" class="nlx-hero-bg__node" style="--i:1" />
    <circle cx="120" cy="204" r="2.5" class="nlx-hero-bg__node" style="--i:2" />
    <circle cx="184" cy="240" r="3" class="nlx-hero-bg__node" style="--i:3" />
  </g>

  <g class="nlx-hero-bg__wing nlx-hero-bg__wing--right" stroke="#818cf8" stroke-width="1.5" stroke-linecap="round">
    <g stroke-opacity="0.25">
          <path d="M1220 64 H1080 L1038 106 H940" pathLength="100" class="nlx-hero-bg__trace" style="--i:0" />
          <path d="M1220 176 H1110 L1072 214 H980" pathLength="100" class="nlx-hero-bg__trace" style="--i:1" />
          <path d="M1150 276 H1048 L1008 236 H915" pathLength="100" class="nlx-hero-bg__trace" style="--i:2" />
    </g>
    <g stroke-opacity="0.95" stroke-width="2">
          <path d="M1220 64 H1080 L1038 106 H940" pathLength="100" class="nlx-hero-bg__packet" style="--i:0" />
          <path d="M1220 176 H1110 L1072 214 H980" pathLength="100" class="nlx-hero-bg__packet" style="--i:1" />
          <path d="M1150 276 H1048 L1008 236 H915" pathLength="100" class="nlx-hero-bg__packet" style="--i:2" />
    </g>
  </g>
  <g fill="#818cf8">
    <circle cx="1080" cy="64" r="3" class="nlx-hero-bg__node" style="--i:4" />
    <circle cx="940" cy="106" r="3.5" class="nlx-hero-bg__node" style="--i:5" />
    <circle cx="1072" cy="214" r="2.5" class="nlx-hero-bg__node" style="--i:6" />
    <circle cx="1008" cy="236" r="3" class="nlx-hero-bg__node" style="--i:7" />
  </g>

  <rect x="120" y="0.5" width="960" height="1" fill="url(#nlxHeroBeam)" class="nlx-hero-bg__beam" />
  <rect x="240" y="318.5" width="720" height="1" fill="url(#nlxHeroBeam)" class="nlx-hero-bg__beam nlx-hero-bg__beam--b" />
</svg>

<style is:global>
  .nlx-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; color: var(--text-secondary); }

  /* Packets: a short dash travelling along each circuit trace */
  .nlx-hero-bg__packet { stroke-dasharray: 7 93; stroke-dashoffset: 7; animation: nlx-packet 4.8s cubic-bezier(.45,.05,.4,.95) infinite; animation-delay: calc(var(--i) * 1.1s); filter: drop-shadow(0 0 4px currentColor); }
  .nlx-hero-bg__wing--right .nlx-hero-bg__packet { animation-delay: calc(var(--i) * 1.1s + 0.6s); }
  @keyframes nlx-packet { 0% { stroke-dashoffset: 7; opacity: 0; } 8% { opacity: 1; } 70% { opacity: 1; } 100% { stroke-dashoffset: -100; opacity: 0; } }

  .nlx-hero-bg__trace { stroke-dasharray: 100; stroke-dashoffset: 100; animation: nlx-draw 1.6s ease-out forwards; animation-delay: calc(var(--i) * .18s); }
  @keyframes nlx-draw { to { stroke-dashoffset: 0; } }

  .nlx-hero-bg__node { transform-box: fill-box; transform-origin: center; fill-opacity: .7; animation: nlx-node 3.2s ease-in-out infinite; animation-delay: calc(var(--i) * .4s); }
  @keyframes nlx-node { 0%, 100% { transform: scale(1); fill-opacity: .55; } 50% { transform: scale(1.7); fill-opacity: 1; } }

  .nlx-hero-bg__grid { animation: nlx-grid 18s linear infinite; }
  @keyframes nlx-grid { to { transform: translate(48px, 48px); } }

  .nlx-hero-bg__sweep { animation: nlx-sweep 9s ease-in-out infinite; }
  @keyframes nlx-sweep { 0% { transform: translateX(0); } 60%, 100% { transform: translateX(1500px); } }

  .nlx-hero-bg__breathe { animation: nlx-breathe 7s ease-in-out infinite; }
  @keyframes nlx-breathe { 0%, 100% { opacity: .75; } 50% { opacity: 1; } }
  .nlx-hero-bg__drift { animation: nlx-drift 11s ease-in-out infinite alternate; }
  .nlx-hero-bg__drift--b { animation-duration: 14s; animation-direction: alternate-reverse; }
  @keyframes nlx-drift { from { transform: translate(-24px, 6px); } to { transform: translate(24px, -6px); } }

  .nlx-hero-bg__beam { animation: nlx-beam 5s ease-in-out infinite; }
  .nlx-hero-bg__beam--b { animation-delay: 2.5s; }
  @keyframes nlx-beam { 0%, 100% { opacity: .35; } 50% { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .nlx-hero-bg * { animation: none !important; }
    .nlx-hero-bg__packet { display: none; }
    .nlx-hero-bg__trace { stroke-dashoffset: 0; }
  }
</style>
