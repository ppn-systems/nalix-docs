---
import { render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import { getStaticPathsForAllEnabledLocales, type ResolvedDoc } from '../../utils/content-loader';

export async function getStaticPaths() {
  return await getStaticPathsForAllEnabledLocales();
}

type Props = ResolvedDoc;

const { entry, locale, sourceLocale, slug, relFile, isFallback } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocLayout
  title={entry.data.title}
  description={entry.data.description}
  pkg={entry.data.package}
  locale={locale}
  sourceLocale={sourceLocale}
  slug={slug}
  relFile={relFile}
  isFallback={isFallback}
  headings={headings}
  rawBody={entry.body}
>
  <Content />
</DocLayout>
