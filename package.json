{
  "name": "nalix-docs",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Official documentation for the Nalix .NET 10 real-time networking framework — built with Astro and i18n support.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run && python3 -m unittest discover -s tools/tests -t tools",
    "test:watch": "vitest",
    "check": "npm run test && npm run build",
    "deploy": "wrangler pages deploy",
    "sync:check": "python3 tools/run.py sync-check",
    "sync:update": "python3 tools/run.py sync-update",
    "audit": "python3 tools/run.py audit --baseline tools/docs-audit-baseline.json",
    "coverage": "python3 tools/run.py coverage",
    "l10n": "python3 tools/l10n.py",
    "l10n:status": "python3 tools/l10n.py status --locale vi-vn",
    "l10n:check": "python3 tools/l10n.py check --locale vi-vn"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.4.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "mermaid": "^12.2.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
